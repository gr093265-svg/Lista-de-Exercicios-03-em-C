#include <stdio.h> 

  

int main() { 

    char produto[50]; 

    int quantidade; 

    float preco, total; 

  

    printf("Digite o nome do produto: "); 

    scanf("%s", produto); 

    printf("Digite a quantidade: "); 

    scanf("%d", &quantidade); 

    printf("Digite o preço unitário: "); 

    scanf("%f", &preco); 

  

    total = quantidade * preco; 

  

    printf("Produto: %s\n", produto); 

    printf("Valor total: R$ %.2f\n", total); 

  

    return 0; 

} 
