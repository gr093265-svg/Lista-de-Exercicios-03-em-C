 

#include <stdio.h> 

  

int main() { 

    float n1, n2; 

    char op; 

  

    printf("Digite o primeiro número: "); 

    scanf("%f", &n1); 

    printf("Digite o segundo número: "); 

    scanf("%f", &n2); 

    printf("Digite a operação (+, -, * ou /): "); 

    scanf(" %c", &op); 

  

    if (op == '+') { 

        printf("Resultado: %.2f\n", n1 + n2); 

    } else if (op == '-') { 

        printf("Resultado: %.2f\n", n1 - n2); 

    } else if (op == '*') { 

        printf("Resultado: %.2f\n", n1 * n2); 

    } else if (op == '/') { 

        if (n2 == 0) { 

            printf("Erro: divisão por zero\n"); 

        } else { 

            printf("Resultado: %.2f\n", n1 / n2); 

        } 

    } else { 

        printf("Operação inválida\n"); 

    } 

  

    return 0; 

} 
