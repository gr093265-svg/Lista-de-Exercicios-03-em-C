#include <stdio.h> 

  

int main() { 

    int qtd, i; 

    float nota, soma = 0, media; 

  

    printf("Digite a quantidade de alunos: "); 

    scanf("%d", &qtd); 

  

    for (i = 1; i <= qtd; i++) { 

        printf("Digite a nota do aluno %d: ", i); 

        scanf("%f", &nota); 

        soma = soma + nota; 

    } 

  

    media = soma / qtd; 

  

    printf("Média geral da turma: %.2f\n", media); 

  

    return 0; 

} 
