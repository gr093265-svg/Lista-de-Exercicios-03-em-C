#include <stdio.h> 

  

int main() { 

    int v1 = 0, v2 = 0, v3 = 0, voto, total; 

  

    printf("Digite o voto (1, 2, 3 ou 0 para encerrar): "); 

    scanf("%d", &voto); 

  

    while (voto != 0) { 

        if (voto == 1) { 

            v1 = v1 + 1; 

        } else if (voto == 2) { 

            v2 = v2 + 1; 

        } else if (voto == 3) { 

            v3 = v3 + 1; 

        } else { 

            printf("Voto inválido\n"); 

        } 

  

        printf("Digite o voto (1, 2, 3 ou 0 para encerrar): "); 

        scanf("%d", &voto); 

    } 

  

    total = v1 + v2 + v3; 

  

    printf("Votos do candidato 1: %d\n", v1); 

    printf("Votos do candidato 2: %d\n", v2); 

    printf("Votos do candidato 3: %d\n", v3); 

    printf("Total de votos: %d\n", total); 

  

    if (v1 > v2 && v1 > v3) { 

        printf("Vencedor: Candidato 1\n"); 

    } else if (v2 > v1 && v2 > v3) { 

        printf("Vencedor: Candidato 2\n"); 

    } else if (v3 > v1 && v3 > v2) { 

        printf("Vencedor: Candidato 3\n"); 

    } else { 

        printf("Empate\n"); 

    } 

  

    return 0; 

} 
