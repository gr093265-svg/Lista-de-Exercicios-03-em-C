#include <stdio.h> 

  

int main() { 

    float distancia, litros, consumo; 

  

    printf("Digite a distância percorrida (km): "); 

    scanf("%f", &distancia); 

    printf("Digite o combustível utilizado (litros): "); 

    scanf("%f", &litros); 

  

    consumo = distancia / litros; 

  

    printf("Consumo médio: %.2f km/L\n", consumo); 

  

    return 0; 

} 
