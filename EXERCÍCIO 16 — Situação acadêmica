#include <stdio.h> 

  

int main() { 

    float n1, n2, media; 

  

    printf("Digite a nota 1: "); 

    scanf("%f", &n1); 

    printf("Digite a nota 2: "); 

    scanf("%f", &n2); 

  

    media = (n1 + n2) / 2; 

  

    printf("Média: %.2f\n", media); 

  

    if (media >= 7) { 

        printf("Aprovado\n"); 

    } else if (media >= 5) { 

        printf("Recuperação\n"); 

    } else { 

        printf("Reprovado\n"); 

    } 

  

    return 0; 

} 
