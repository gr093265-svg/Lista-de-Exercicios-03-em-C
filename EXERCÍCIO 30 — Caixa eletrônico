#include <stdio.h> 

  

int main() { 

    float saldo = 1000, valor; 

    int opcao = 0; 

  

    while (opcao != 4) { 

        printf("1. Consultar saldo\n"); 

        printf("2. Depositar\n"); 

        printf("3. Sacar\n"); 

        printf("4. Sair\n"); 

        scanf("%d", &opcao); 

  

        if (opcao == 1) { 

            printf("Saldo: R$ %.2f\n", saldo); 

        } else if (opcao == 2) { 

            printf("Digite o valor do depósito: "); 

            scanf("%f", &valor); 

            saldo = saldo + valor; 

        } else if (opcao == 3) { 

            printf("Digite o valor do saque: "); 

            scanf("%f", &valor); 

            if (valor <= saldo) { 

                saldo = saldo - valor; 

            } else { 

                printf("Saldo insuficiente\n"); 

            } 

        } else if (opcao == 4) { 

            printf("Saindo...\n"); 

        } else { 

            printf("Opção inválida\n"); 

        } 

    } 

  

    return 0; 

} 
